<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <!--
      Bespoke transactional outbox. timeline-service has no Spring Modulith event-publication registry
      (single bounded context — see developer-notes.md §2), so unlike game-service it cannot rely on
      Modulith's event_publication table; this table plus OutboxEventListener/OutboxRelay is the
      service-local equivalent of the generic pattern in developer-notes.md's "Outbox Pattern" section.
  -->
  <changeSet id="003-create-outbox-events" author="timeline-service">
    <createTable tableName="outbox_events">
      <column name="id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <!--
          Relay ordering key. created_at (clock-resolution timestamp) ties when a single command
          handler invocation publishes several events back-to-back (e.g. ProbabilityStateCalculated
          then OutcomeApplied) — a tie would let the relay send them out of the required order. A
          DB-generated monotonic sequence cannot tie.
      -->
      <column name="seq" type="BIGINT" autoIncrement="true">
        <constraints nullable="false"/>
      </column>
      <column name="topic" type="VARCHAR(200)">
        <constraints nullable="false"/>
      </column>
      <column name="message_key" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="headers" type="JSONB">
        <constraints nullable="false"/>
      </column>
      <column name="payload" type="JSONB">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createIndex tableName="outbox_events" indexName="ix_outbox_events_status">
      <column name="status"/>
      <column name="seq"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
