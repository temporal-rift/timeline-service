<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <!--
      Durable per-aggregate snapshots. Aggregates are rebuilt from the latest snapshot plus the
      tail events appended after it instead of a full replay. One row per aggregate id; saves overwrite.
  -->
  <changeSet id="001-create-aggregate-snapshot" author="timeline-service">
    <createTable tableName="aggregate_snapshot">
      <column name="aggregate_id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="aggregate_type" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="snapshot_data" type="JSONB">
        <constraints nullable="false"/>
      </column>
      <column name="sequence_nr" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

</databaseChangeLog>
