<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.temporal-rift</groupId>
        <artifactId>temporal-rift-bom</artifactId>
        <version>1.5.3</version>
        <relativePath/>
    </parent>

    <artifactId>timeline-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Temporal Rift Timeline Service</name>
    <description>Temporal Rift timeline resolution service — event-sourced core domain</description>
    <url/>

    <licenses>
        <license>
            <name>GNU General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kronen</id>
            <name>Alberto Gonzalez Lagos</name>
            <email>kronenr@gmail.com</email>
            <url>https://github.com/kronen</url>
            <roles>
                <role>architect</role>
                <role>developer</role>
            </roles>
            <timezone>Europe/Madrid</timezone>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:temporal-rift/timeline-service.git</connection>
        <developerConnection>scm:git:git@github.com:temporal-rift/timeline-service.git</developerConnection>
        <url>https://github.com/temporal-rift/timeline-service</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <sonar.organization>temporal-rift</sonar.organization>
        <sonar.projectKey>temporal-rift_timeline-service</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>**/generated-sources/**/*</sonar.exclusions>
        <sonar.coverage.exclusions>**/generated-sources/**/*</sonar.coverage.exclusions>

        <timeline-event.version>1.0.2</timeline-event.version>
        <archunit-junit5.version>1.4.2</archunit-junit5.version>
    </properties>

    <dependencies>
        <!-- Spec-only: bundles timeline-event's asyncapi.yml, no compiled code. Codegen is driven by the
             zenwave-sdk-maven-plugin execution below (plugin identity managed in temporal-rift-bom). Only
             the payload/header model + producer method shapes are used here — the generated producer's
             applicationEventPublisher.publishEvent(message) call is captured by this service's own
             OutboxEventListener (infrastructure.adapter.out.outbox), not by Spring Modulith, which this
             single-bounded-context service deliberately does not use (see developer-notes.md §2). -->
        <dependency>
            <groupId>io.github.temporal-rift</groupId>
            <artifactId>timeline-event</artifactId>
            <version>${timeline-event.version}</version>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-zipkin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Required by the generated timeline-event model classes' @NotNull/@Valid annotations. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Producing generated timeline-event Message events uses spring-messaging's Message/MessageBuilder,
             consumed by OutboxEventListener; no Spring Cloud Stream binder or Modulith externalization is
             wired here (see pom.xml comment above / design.md Decision 4). -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-messaging</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit-junit5.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>unpack-timeline-event-spec</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>timeline-event</includeArtifactIds>
                            <includes>asyncapi/**</includes>
                            <outputDirectory>${project.build.directory}/dependency-specs/timeline</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.zenwave360.sdk</groupId>
                <artifactId>zenwave-sdk-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-timeline-events</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.build.directory}/dependency-specs/timeline/asyncapi/asyncapi.yml
                            </inputSpec>
                            <configOptions>
                                <role>provider</role>
                                <componentPrefix>Timeline</componentPrefix>
                                <modelPackage>
                                    io.github.temporalrift.timeline.infrastructure.adapter.out.kafka.model
                                </modelPackage>
                                <producerApiPackage>
                                    io.github.temporalrift.timeline.infrastructure.adapter.out.kafka.producer
                                </producerApiPackage>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-zenwave-generated-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/zenwave/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
