<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.temporal-rift</groupId>
        <artifactId>temporal-rift-bom</artifactId>
        <version>1.12.0</version>
        <relativePath/>
    </parent>

    <artifactId>timeline-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Temporal Rift Timeline Service</name>
    <description>Temporal Rift timeline resolution service — event-sourced core domain</description>
    <url/>

    <licenses>
        <license>
            <name>GNU General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kronen</id>
            <name>Alberto Gonzalez Lagos</name>
            <email>kronenr@gmail.com</email>
            <url>https://github.com/kronen</url>
            <roles>
                <role>architect</role>
                <role>developer</role>
            </roles>
            <timezone>Europe/Madrid</timezone>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:temporal-rift/timeline-service.git</connection>
        <developerConnection>scm:git:git@github.com:temporal-rift/timeline-service.git</developerConnection>
        <url>https://github.com/temporal-rift/timeline-service</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <sonar.organization>temporal-rift</sonar.organization>
        <sonar.projectKey>temporal-rift_timeline-service</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>**/generated-sources/**/*</sonar.exclusions>
        <sonar.coverage.exclusions>**/generated-sources/**/*</sonar.coverage.exclusions>

        <timeline-event.version>4.0.0</timeline-event.version>
        <session-event.version>2.0.0</session-event.version>
        <action-event.version>4.0.0</action-event.version>
        <chains-api.version>1.1.0</chains-api.version>
        <archunit-junit5.version>1.4.2</archunit-junit5.version>
    </properties>

    <dependencies>
        <!-- Spec-only: bundles timeline-event's asyncapi.yml, no compiled code. -->
        <dependency>
            <groupId>io.github.temporal-rift</groupId>
            <artifactId>timeline-event</artifactId>
            <version>${timeline-event.version}</version>
        </dependency>
        <!-- Spec-only: bundles session-event's asyncapi.yml, no compiled code. Consumed for EraStarted,
             EventsDrawn, and ResolutionStarted, which this service reads from game.events but does not produce. -->
        <dependency>
            <groupId>io.github.temporal-rift</groupId>
            <artifactId>session-event</artifactId>
            <version>${session-event.version}</version>
        </dependency>
        <!-- Spec-only: bundles action-event's asyncapi.yml, no compiled code. Consumed for CardPlayed,
             SpecialActionPlayed, ActionRoundClosed, ParadoxResolutionCardPlayed, and ActivistDeclarationRecorded,
             which this service reads from game.events but does not produce. -->
        <dependency>
            <groupId>io.github.temporal-rift</groupId>
            <artifactId>action-event</artifactId>
            <version>${action-event.version}</version>
        </dependency>
        <!-- Spec-only: bundles chains-api's OpenAPI specification. Codegen for it is driven by the
             openapi-generator-maven-plugin execution below. -->
        <dependency>
            <groupId>io.github.temporal-rift</groupId>
            <artifactId>chains-api</artifactId>
            <version>${chains-api.version}</version>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-zipkin</artifactId>
        </dependency>
        <!-- Sources game.rules.probability.* from the shared infrastructure Config Server by default;
             see spring.config.import in application.yml. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Required by the generated chains-api model classes' @Schema annotations. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>
        <!-- Required by the generated timeline-event model classes' @NotNull/@Valid annotations. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Producing generated timeline-event Message events uses spring-messaging's Message/MessageBuilder,
             consumed by OutboxEventListener; no Spring Cloud Stream binder or Modulith externalization is
             wired here (see pom.xml comment above / the governing design Decision 4). -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-messaging</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit-junit5.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <configuration>
                    <importMappings>
                        <importMapping>ProblemDetail=org.springframework.http.ProblemDetail</importMapping>
                    </importMappings>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-chains-api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>
                                ${project.build.directory}/dependency-specs/chains-api-${chains-api.version}-jar/openapi/v1/chains.yml
                            </inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi/chains</output>
                            <apiPackage>io.github.temporalrift.timeline.infrastructure.adapter.in.rest.v1
                            </apiPackage>
                            <modelPackage>io.github.temporalrift.timeline.infrastructure.adapter.in.rest.v1.model
                            </modelPackage>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-openapi-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>
                                    ${project.build.directory}/generated-sources/openapi/chains/src/main/java
                                </source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>unpack-timeline-event-spec</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>timeline-event</includeArtifactIds>
                            <includes>asyncapi/**</includes>
                            <outputDirectory>${project.build.directory}/dependency-specs/timeline</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
